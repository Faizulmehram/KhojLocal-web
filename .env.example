# =============================================================================
# Frontend (Vite) — must be prefixed with VITE_ to be exposed to the browser
# =============================================================================

# Google Maps API Key for location features
# Get your API key from: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Base URL the frontend uses to reach the backend API.
# - Local dev: leave EMPTY. Vite proxies /api -> localhost:5000 (see vite.config.js).
# - Vercel:    leave EMPTY. The backend runs at /api on the same domain (same origin).
# - Separate backend host: set the full origin, no trailing slash, e.g.
#     VITE_API_URL=https://my-backend.onrender.com
VITE_API_URL=

# =============================================================================
# Backend (Express) — set these in the Vercel dashboard for the deployment
# =============================================================================

# Server Configuration (PORT is only used for local `npm run server`)
PORT=5000
NODE_ENV=development

# Database — use a hosted MongoDB (e.g. MongoDB Atlas) for the deployment.
# A localhost URI will NOT work on Vercel.
MONGODB_URI=mongodb://localhost:27017/khoojlocal

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Public URL of the deployed frontend, used for Stripe success/cancel redirects.
# On Vercel set this to your deployment domain, e.g. https://kl-web.vercel.app
FRONTEND_URL=http://localhost:3000

# Gemini (optional — CNIC service; currently disabled)
GEMINI_API_KEY=your_gemini_api_key
